# ===== 必填 =====
MESH_SECRET=随便一串长随机字符串-用于登录会话签名
# 生产（https:// 或 MESH_ENV=production）若 SECRET 过弱会拒绝启动
# MESH_ENV=production
MESH_ADMIN_PASSWORD=管理员 admin 的密码
MESH_OWNER_PASSWORD=所有者 owner 的密码（只有 owner 能确认上线；不填则与 admin 相同）
# 测试/本地可开账号密码登录框（生产 MESH_ENV=prod|production 即使设了也会拒绝）
# MESH_ALLOW_PASSWORD_LOGIN=1

# ===== 模型（适配层）=====
# 切换模型只改这里，业务代码零改动。
# 可选：anthropic | doubao | deepseek | qwen | openai_compat
MESH_LLM_PROVIDER=anthropic

# --- 用 anthropic 时填这两行 ---
ANTHROPIC_API_KEY=sk-ant-在这里填
MESH_LLM_MODEL=claude-sonnet-4-6

# --- 用豆包/DeepSeek/通义等 OpenAI 兼容接口时改填这四行，并把上面 PROVIDER 改掉 ---
# MESH_LLM_API_KEY=
# MESH_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MESH_LLM_MODEL=
# MESH_LLM_CONTEXT_WINDOW=128000        # 切分策略按它算，务必填对

# ===== 数据库（二选一）=====
# 默认 SQLite（单机/开发）：
# MESH_DB=data/mesh.db
# 生产推荐 PostgreSQL（多人并发 Ask / EDM）：
# MESH_DB_URL=postgresql://mesh:mesh@postgres:5432/mesh
# docker-compose 已内置 postgres 服务；迁移：python deploy/migrate_to_postgres.py
# MESH_UVICORN_WORKERS=2          # 配 PG 时可开 2～4 worker

# ===== 站点 =====
MESH_BASE_URL=https://mesh.geekpark.ai        # 本地测试用 http://localhost:8080
MESH_LOGO_URL=https://mesh.geekpark.ai/static/assets/mesh_logo.png
TZ=Asia/Singapore                              # 部署在新加坡节点；周报日期按此时区结算

# ===== 外部媒体 RSS（逗号分隔，可改）=====
EXTERNAL_FEEDS=https://feeds.arstechnica.com/arstechnica/index,https://venturebeat.com/feed/,https://www.digitaltrends.com/feed/,https://www.technologyreview.com/feed/

# ===== AI 交叉问答（可选）=====
# 团队别名 JSON：问句里的叫法 → 规范团队名（默认已含 Founder Park→社群、Global Partnership 短名等）
# MESH_TEAM_ALIASES={"Founder Park":"社群","FP":"社群"}
# 海外 / 国内团队集合（逗号分隔；用于「海外有国内没有」类问题）
# MESH_OVERSEAS_TEAMS=硅谷 BD 团队,Global Partnership 团队,英文站
# MESH_DOMESTIC_TEAMS=编辑部,商业化团队,品牌创意团队,社群,投资团队,音频播客团队,视频号团队,CEO / 总裁办
# 未写时间范围时的默认窗口（天）、结果条数上限
# MESH_QA_WINDOW_DAYS=30
# MESH_QA_RESULT_LIMIT=30
# 主题题（非交叉）默认检索窗口；问句含「全部历史」则不限
# MESH_QA_LEXICAL_WINDOW_DAYS=90
# 同问句答案缓存秒数（0=关闭）
# MESH_ASK_CACHE_TTL=120
# 多 uvicorn worker 时进程内缓存会自动关闭（避免各 worker 答案不一致）
# 同时进行的 LLM 问答数（超出排队，默认 4）
# MESH_ASK_LLM_CONCURRENCY=2
# 2 uvicorn worker 时建议每进程 2（全站约 4）；可用 MESH_ASK_LLM_GLOBAL 再收紧总帽
# MESH_ASK_LLM_CONCURRENCY=2
# MESH_ASK_LLM_GLOBAL=4
# 后台挖掘/预览 LLM 池（与 Ask 分开，互不挤占）
# MESH_JOB_LLM_CONCURRENCY=2
# MESH_JOB_LLM_GLOBAL=2
# MESH_JOB_QUEUE_TIMEOUT=600
# 生产 docker-compose：Web MESH_JOB_INLINE=0 + mesh-worker；本地默认 1（本进程线程）
# MESH_JOB_INLINE=1
# MESH_JOB_POLL_SEC=1.5
# MESH_DB_POOL_MIN=2
# MESH_DB_POOL_MAX=20
# MESH_ASK_QUEUE_TIMEOUT=120
# MESH_ASK_RATE_PER_MIN=40
# Phase A 多源交叉分析（Ask 默认开启；analysis=0 可关）
# MESH_ASK_ANALYSIS=1
# MESH_ANALYSIS_MAX_GROUPS=4
# MESH_ANALYSIS_MAX_PER_GROUP=6

# ===== 发 EDM 用的邮箱（SMTP）=====
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=mesh@geekpark.net
SMTP_PASSWORD=邮箱授权码
SMTP_FROM=GeekPark Mesh <mesh@geekpark.net>
# 默认 EDM 收件人（逗号分隔；可在后台 EDM 页覆盖）
# EDM_DEFAULT_TO=team@geekpark.net

# ===== 向量检索（可选；默认开启，无 embedding API 时自动降级为纯 FTS）=====
# 生产 mesh.geekpark.ai 已配置金山星流 Embedding（服务器 .env）。
# 本地 healthz 若 embeddings_configured=false，是本机缺真实 Key，不是产品未接入。
MESH_EMBED_ENABLED=1
# 金山云星流 OpenAI 兼容 Embedding（与 LLM 可不同厂商）
# 文档：https://docs.ksyun.com/documents/44800  · 模型：qwen3-embedding-8b
MESH_EMBED_API_KEY=sk-你的星流APIKey
# 生产推荐 kspmas；控制台示例 kapws 在部分机房 DNS 不可达，可逗号分隔多个 fallback
MESH_EMBED_BASE_URL=https://kspmas.ksyun.com/v1
# MESH_EMBED_BASE_URL=https://kspmas.ksyun.com/v1,https://kapws.ksyun.com/v1
MESH_EMBED_MODEL=qwen3-embedding-8b
# MESH_EMBEDDING_MODEL=qwen3-embedding-8b
# MESH_EMBED_BATCH=32
# MESH_VECTOR_ENABLED=1
# MESH_JOB_STALE_SEC=1800
# 未设置 MESH_EMBED_BASE_URL 时回退 MESH_LLM_*（需该厂商支持 /v1/embeddings）

FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Bot 事件订阅（POST /api/feishu/bot/event）
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
# 出站回消息：默认开启（需 App 凭证）；设 0 可关掉
# FEISHU_BOT_REPLY=1
# 飞书白名单（逗号分隔）。命中后首次/再次登录都会自动授予对应角色。
# FEISHU_OWNER_OPEN_IDS=ou_xxx,ou_yyy
# FEISHU_ADMIN_OPEN_IDS=ou_xxx

# ===== Feishu Hands（Colleague 手脚；默认关）=====
# MESH_FEISHU_HANDS=0
# MESH_FEISHU_HANDS_WRITE=0
# 运行时后端：native（默认/生产停靠）| cli（金丝雀，见 docs/CLI_ADAPTER_READINESS.md）| mcp | mock
# MESH_FEISHU_HANDS_BACKEND=native
# MESH_FEISHU_HANDS_MCP_URL=http://127.0.0.1:9800/tools/call
# MESH_FEISHU_CLI_BIN=lark-cli
# Official CLI headless creds（可选；docker-entry 会从 FEISHU_APP_* 映射）：
# LARKSUITE_CLI_APP_ID=
# LARKSUITE_CLI_APP_SECRET=
# LARKSUITE_CLI_BRAND=feishu

# ===== Notion CRM 底库（可选；问答检索用，周报仍走聚合窗口）=====
# NOTION_TOKEN=ntn_你的IntegrationSecret
# 四个库 URL/ID，逗号或换行；也可分项 NOTION_DB_COMPANIES / PEOPLE / INTERACTIONS / TAKES
# NOTION_DATABASE_URL=
# 同步：python -m app.notion_crm sync --full
# 增量：python -m app.notion_crm sync
# 状态：python -m app.notion_crm status
# 后台：GET/POST /admin/crm/notion/status|sync?full=1

# ===== 本地演示（可选）=====
# 首次建库时创建 biz/viewer 演示账号，并允许使用 mesh-admin 等弱口令。生产勿开。
# MESH_ALLOW_DEMO_PASSWORDS=1
