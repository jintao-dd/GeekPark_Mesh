# ===== 必填 =====
MESH_SECRET=随便一串长随机字符串-用于登录会话签名
MESH_ADMIN_PASSWORD=管理员 admin 的密码
MESH_OWNER_PASSWORD=所有者 owner 的密码（只有 owner 能确认上线；不填则与 admin 相同）

# ===== 模型（适配层）=====
# 切换模型只改这里，业务代码零改动。
# 可选：anthropic | doubao | deepseek | qwen | openai_compat
MESH_LLM_PROVIDER=anthropic

# --- 用 anthropic 时填这两行 ---
ANTHROPIC_API_KEY=sk-ant-在这里填
MESH_LLM_MODEL=claude-sonnet-4-6

# --- 用豆包/DeepSeek/通义等 OpenAI 兼容接口时改填这四行，并把上面 PROVIDER 改掉 ---
# MESH_LLM_API_KEY=
# MESH_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MESH_LLM_MODEL=
# MESH_LLM_CONTEXT_WINDOW=128000        # 切分策略按它算，务必填对

# ===== 站点 =====
MESH_BASE_URL=https://mesh.geekpark.ai        # 本地测试用 http://localhost:8080
MESH_LOGO_URL=https://mesh.geekpark.ai/static/assets/mesh_logo.png
TZ=Asia/Singapore                              # 部署在新加坡节点；周报日期按此时区结算

# ===== 外部媒体 RSS（逗号分隔，可改）=====
EXTERNAL_FEEDS=https://feeds.arstechnica.com/arstechnica/index,https://venturebeat.com/feed/,https://www.digitaltrends.com/feed/,https://www.technologyreview.com/feed/

# ===== AI 交叉问答（可选）=====
# 团队别名 JSON：问句里的叫法 → 规范团队名（默认已含 Founder Park→社群、Global Partnership 短名等）
# MESH_TEAM_ALIASES={"Founder Park":"社群","FP":"社群"}
# 海外 / 国内团队集合（逗号分隔；用于「海外有国内没有」类问题）
# MESH_OVERSEAS_TEAMS=硅谷 BD 团队,Global Partnership 团队,英文站
# MESH_DOMESTIC_TEAMS=编辑部,商业化团队,品牌创意团队,社群,投资团队,音频播客团队,视频号团队,CEO / 总裁办
# 未写时间范围时的默认窗口（天）、结果条数上限
# MESH_QA_WINDOW_DAYS=30
# MESH_QA_RESULT_LIMIT=30
# 主题题（非交叉）默认检索窗口；问句含「全部历史」则不限
# MESH_QA_LEXICAL_WINDOW_DAYS=90
# 同问句答案缓存秒数（0=关闭）
# MESH_ASK_CACHE_TTL=120

# ===== 发 EDM 用的邮箱（SMTP）=====
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=mesh@geekpark.net
SMTP_PASSWORD=邮箱授权码
SMTP_FROM=GeekPark Mesh <mesh@geekpark.net>

# ===== 向量检索（可选；默认开启，无 embedding API 时自动降级为纯 FTS）=====
MESH_EMBED_ENABLED=1
# MESH_EMBED_API_KEY=          # 默认同 MESH_LLM_API_KEY
# MESH_EMBED_BASE_URL=         # 默认同 MESH_LLM_BASE_URL；OpenAI 填 https://api.openai.com/v1
# MESH_EMBED_MODEL=text-embedding-3-small

FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书白名单（逗号分隔）。命中后首次/再次登录都会自动授予对应角色。
# FEISHU_OWNER_OPEN_IDS=ou_xxx,ou_yyy
# FEISHU_ADMIN_OPEN_IDS=ou_xxx
# ===== 本地演示（可选）=====
# 首次建库时创建 biz/viewer 演示账号，并允许使用 mesh-admin 等弱口令。生产勿开。
# MESH_ALLOW_DEMO_PASSWORDS=1
